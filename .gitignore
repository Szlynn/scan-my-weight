# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio IDE files
*.iml
.idea/

# Kotlin compiler & cache files
.kotlin/

# Keystore files (Soha ne pusholj fel aláíró kulcsokat!)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (ha használnál Firebase-t vagy Google API kulcsot)
google-services.json

# OS generated files
.DS_Store
Thumbs.db

# Local
scratch/

